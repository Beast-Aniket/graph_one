# Core
APP_ENV=local
API_PREFIX=/api/v1
API_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL + pgvector (PRD primary store)
DATABASE_URL=postgresql+asyncpg://graphone:graphone@postgres:5432/graphone

# Distributed processing
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Raw source evidence (MinIO / S3-compatible)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=graphone
S3_SECRET_KEY=change-this-minio-secret
S3_BUCKET=graphone-raw
S3_REGION=us-east-1

# Relationship graph (PRD graph layer)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# Crawl / extraction
CRAWLER_USER_AGENT=GraphOneFrontierAtlas/1.0 (+replace-with-contact@example.com)
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_RETRIES=4
CRAWLER_CONCURRENCY=5
LLM_MAX_CHUNK_CHARS=12000

# Optional grounded extraction fallback: Gemini -> Groq -> DeepSeek
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional external delivery
GOOGLE_SHEETS_WEBHOOK_URL=
GITHUB_TOKEN=

